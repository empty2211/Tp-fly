local function makeDraggable(element)
	local dragging = false
	local dragStart = nil
	local startPos = nil

	element.InputBegan:Connect(function(input)
		if not editMode then return end
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = element.Position
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not editMode or not dragging then return end
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			element.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
end

local function makeDraggableButton(button, onClick)
	local dragging = false
	local dragStart = nil
	local startPos = nil
	local moved = false
	local TAP_THRESHOLD = 8

	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = button.Position
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			if delta.Magnitude > TAP_THRESHOLD then
				moved = true
			end
			if moved then
				button.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not moved then
				if onClick then onClick() end
			end
			dragging = false
			moved = false
		end
	end)
end

if isMobile then
	local joySize = 140
	local thumbSize = 60

	local joyBase = Instance.new("Frame")
	joyBase.Name = "FlyJoystick"
	joyBase.Size = UDim2.new(0, joySize, 0, joySize)
	joyBase.Position = UDim2.new(0, 30, 1, -joySize - 170)
	joyBase.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	joyBase.BackgroundTransparency = 0.75
	joyBase.BorderSizePixel = 0
	joyBase.Active = true
	joyBase.ZIndex = 10
	joyBase.Visible = false
	joyBase.Parent = main
	mobileJoy = joyBase

	local joyCorner = Instance.new("UICorner")
	joyCorner.CornerRadius = UDim.new(1, 0)
	joyCorner.Parent = joyBase

	local joyStroke = Instance.new("UIStroke")
	joyStroke.Color = Color3.fromRGB(0, 170, 255)
	joyStroke.Thickness = 2
	joyStroke.Transparency = 0.3
	joyStroke.Parent = joyBase

	local joyThumb = Instance.new("Frame")
	joyThumb.Size = UDim2.new(0, thumbSize, 0, thumbSize)
	joyThumb.Position = UDim2.new(0.5, -thumbSize/2, 0.5, -thumbSize/2)
	joyThumb.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	joyThumb.BackgroundTransparency = 0.2
	joyThumb.BorderSizePixel = 0
	joyThumb.ZIndex = 11
	joyThumb.Parent = joyBase
	mobileJoyThumb = joyThumb

	local thumbCorner = Instance.new("UICorner")
	thumbCorner.CornerRadius = UDim.new(1, 0)
	thumbCorner.Parent = joyThumb

	local joystickTouch = nil
	local maxDist = joySize / 2

	local function updateJoy(inputPos)
		local baseAbs = joyBase.AbsolutePosition
		local baseSize = joyBase.AbsoluteSize
		local center = Vector2.new(baseAbs.X + baseSize.X/2, baseAbs.Y + baseSize.Y/2)
		local delta = Vector2.new(inputPos.X - center.X, inputPos.Y - center.Y)
		if delta.Magnitude > maxDist then
			delta = delta.Unit * maxDist
		end
		joyThumb.Position = UDim2.new(0.5, delta.X - thumbSize/2, 0.5, delta.Y - thumbSize/2)
		joyInput = Vector2.new(delta.X / maxDist, delta.Y / maxDist)
	end

	local function resetJoy()
		joystickTouch = nil
		joyInput = Vector2.zero
		joyThumb.Position = UDim2.new(0.5, -thumbSize/2, 0.5, -thumbSize/2)
	end

	joyBase.InputBegan:Connect(function(input)
		if editMode then return end
		if input.UserInputType == Enum.UserInputType.Touch then
			joystickTouch = input
			updateJoy(input.Position)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if editMode then return end
		if joystickTouch and input == joystickTouch then
			updateJoy(input.Position)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if joystickTouch and input == joystickTouch then
			resetJoy()
		end
	end)

	makeDraggable(joyBase)

	local vBtnSize = 70

	local upBtn = Instance.new("TextButton")
	upBtn.Name = "FlyUpBtn"
	upBtn.Size = UDim2.new(0, vBtnSize, 0, vBtnSize)
	upBtn.Position = UDim2.new(1, -vBtnSize - 30, 1, -vBtnSize*2 - 160)
	upBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	upBtn.BackgroundTransparency = 0.25
	upBtn.Text = "▲"
	upBtn.TextSize = 30
	upBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	upBtn.Font = Enum.Font.GothamBold
	upBtn.AutoButtonColor = false
	upBtn.ZIndex = 10
	upBtn.Visible = false
	upBtn.Parent = main
	mobileUpBtn = upBtn

	local upCorner = Instance.new("UICorner")
	upCorner.CornerRadius = UDim.new(0.5, 0)
	upCorner.Parent = upBtn

	local downBtn = Instance.new("TextButton")
	downBtn.Name = "FlyDownBtn"
	downBtn.Size = UDim2.new(0, vBtnSize, 0, vBtnSize)
	downBtn.Position = UDim2.new(1, -vBtnSize - 30, 1, -vBtnSize - 80)
	downBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	downBtn.BackgroundTransparency = 0.25
	downBtn.Text = "▼"
	downBtn.TextSize = 30
	downBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	downBtn.Font = Enum.Font.GothamBold
	downBtn.AutoButtonColor = false
	downBtn.ZIndex = 10
