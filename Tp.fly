	end)
	downBtn.MouseButton1Up:Connect(function()
		if vertInput == -1 then vertInput = 0 end
		downBtn.BackgroundTransparency = 0.25
	end)
	downBtn.MouseLeave:Connect(function()
		if vertInput == -1 then vertInput = 0 end
		downBtn.BackgroundTransparency = 0.25
	end)

	makeDraggable(upBtn)
	makeDraggable(downBtn)

	editBtn = Instance.new("TextButton")
	editBtn.Name = "EditPosBtn"
	editBtn.Size = UDim2.new(0, 170, 0, 40)
	editBtn.Position = UDim2.new(1, -180, 0, 100)
	editBtn.BackgroundColor3 = Color3.fromRGB(150, 100, 220)
	editBtn.Text = "✎ Изменить положение"
	editBtn.TextSize = 14
	editBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	editBtn.Font = Enum.Font.GothamBold
	editBtn.AutoButtonColor = false
	editBtn.ZIndex = 10
	editBtn.Parent = main

	local editCorner = Instance.new("UICorner")
	editCorner.CornerRadius = UDim.new(0, 8)
	editCorner.Parent = editBtn

	local editStroke = Instance.new("UIStroke")
	editStroke.Color = Color3.fromRGB(255, 255, 255)
	editStroke.Thickness = 2
	editStroke.Transparency = 0.5
	editStroke.Parent = editBtn
end

local function setEditMode(state)
	editMode = state

	joyInput = Vector2.zero
	vertInput = 0

	if editMode then
		if mobileJoy then mobileJoy.Visible = true end
		if mobileUpBtn then mobileUpBtn.Visible = true end
		if mobileDownBtn then mobileDownBtn.Visible = true end

		if mobileJoy then
			local stroke = mobileJoy:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Color3.fromRGB(255, 200, 0)
				stroke.Transparency = 0
				stroke.Thickness = 4
			end
			mobileJoy.BackgroundTransparency = 0.6
		end
		if mobileUpBtn then mobileUpBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0) end
		if mobileDownBtn then mobileDownBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0) end

		if editBtn then
			editBtn.Text = "✓ Готово"
			editBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
		end
	else
		if not flying then
			if mobileJoy then mobileJoy.Visible = false end
			if mobileUpBtn then mobileUpBtn.Visible = false end
			if mobileDownBtn then mobileDownBtn.Visible = false end
		end

		if mobileJoy then
			local stroke = mobileJoy:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Color3.fromRGB(0, 170, 255)
				stroke.Transparency = 0.3
				stroke.Thickness = 2
			end
			mobileJoy.BackgroundTransparency = 0.75
		end
		if mobileUpBtn then mobileUpBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255) end
		if mobileDownBtn then mobileDownBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255) end

		if editBtn then
			editBtn.Text = "✎ Изменить положение"
			editBtn.BackgroundColor3 = Color3.fromRGB(150, 100, 220)
		end
	end
end

if editBtn then
	makeDraggableButton(editBtn, function()
		setEditMode(not editMode)
	end)
end

local function setCharacterVisible(state)
	if not character then return end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = state and 1 or 0
		end
	end
end

local function createGhost()
	local oldArchivable = character.Archivable
	character.Archivable = true
	local clone = character:Clone()
	character.Archivable = oldArchivable

	if not clone then
		return nil
	end

	clone.Name = "FlyGhost"

	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			d.LocalTransparencyModifier = 0
		end
	end

	local ch = clone:FindFirstChildOfClass("Humanoid")
	if ch then
		ch.PlatformStand = true
		ch.WalkSpeed = 0
		ch.JumpPower = 0
		ch.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	local hrp = clone:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.Transparency = 1 end

	clone.Parent = workspace
	return clone
end

local function createPlatform()
	local p = Instance.new("Part")
	p.Name = "FlyPlatform"
	p.Size = PLATFORM_SIZE
	p.Anchored = true
	p.CanCollide = true
	p.Material = Enum.Material.Neon
	p.Color = PLATFORM_COLOR
	p.Transparency = 0.3
	p.Parent = workspace
	return p
end

local function startFly()
	if flying then return end
	if not refreshChar() then return end
	flying = true

	startPosition = rootPart.Position

	local ok, err = pcall(function()
		ghost = createGhost()
	end)

	if not ok or not ghost then
		flying = false
		return
	end

	ghost:PivotTo(rootPart.CFrame)

	setCharacterVisible(true)

	rootPart.Anchored = true
	humanoid.PlatformStand = true
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0

	local cam = getCam()
	if cam then
		local ghostHum = ghost:FindFirstChildOfClass("Humanoid")
		if ghostHum then
			cam.CameraSubject = ghostHum
		end
	end

	platform = createPlatform()
	platform.CFrame = CFrame.new(startPosition - Vector3.new(0, PLATFORM_OFFSET, 0))

	connection = RS.RenderStepped:Connect(function(dt)
		if not flying then return end
		if character then
			for _, d in ipairs(character:GetDescendants()) do
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = 1
				end
			end
		end
		if not ghost or not ghost.Parent then return end

		local camNow = getCam()
		if not camNow then return end

		local moveDir = Vector3.zero
		local camCF = camNow.CFrame

		if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end

		if isMobile and not editMode then
			if joyInput.Magnitude > 0.1 then
				local forward = -joyInput.Y
				local right = joyInput.X
				moveDir += camCF.LookVector * forward
				moveDir += camCF.RightVector * right
			end
			if vertInput ~= 0 then
				moveDir += Vector3.new(0, vertInput, 0)
			end
		end

		local delta = Vector3.zero
		if moveDir.Magnitude > 0 then
			delta = moveDir.Unit * speed * dt
		end
		local newPivot = ghost:GetPivot() + delta
		ghost:PivotTo(newPivot)

		if platform then
			platform.CFrame = CFrame.new(newPivot.Position - Vector3.new(0, PLATFORM_OFFSET, 0))
		end
	end)
end

local function stopFly()
	if not flying then return end
	flying = false

	local endPosition
	if ghost and ghost.Parent then
		endPosition = ghost:GetPivot().Position
	elseif rootPart then
		endPosition = rootPart.Position
	else
		endPosition = Vector3.zero
	end

	if connection then connection:Disconnect(); connection = nil end
	if ghost then ghost:Destroy(); ghost = nil end
	if platform then platform:Destroy(); platform = nil end

	setCharacterVisible(false)

	if rootPart and humanoid then
		rootPart.Anchored = false
		rootPart.CFrame = CFrame.new(endPosition)
		humanoid.PlatformStand = false
		humanoid.WalkSpeed = 16
		humanoid.JumpPower = 50
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

		local cam = getCam()
		if cam then
			cam.CameraSubject = humanoid
		end
	end

	joyInput = Vector2.zero
	vertInput = 0

	startPosition = nil
end

local function updateFlyButton()
	if flying then
		onof.Text = "stop"
		onof.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		onof.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
		onof.Text = "fly"
		onof.BackgroundColor3 = Color3.fromRGB(255, 249, 74)
		onof.TextColor3 = Color3.fromRGB(0, 0, 0)
	end

	if not editMode then
		if mobileJoy then mobileJoy.Visible = flying end
		if mobileUpBtn then mobileUpBtn.Visible = flying end
		if mobileDownBtn then mobileDownBtn.Visible = flying end
	end
end

updateFlyButton()

local clickDebounce = false
local function onFlyClick()
	if clickDebounce then return end
	clickDebounce = true
	task.delay(0.25, function() clickDebounce = false end)

	onof.BackgroundColor3 = Color3.fromRGB(150, 150, 150)

	if flying then
		pcall(stopFly)
	else
		pcall(startFly)
	end

	updateFlyButton()
end

onof.MouseButton1Down:Connect(onFlyClick)

onof.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		onFlyClick()
	end
end)

up.MouseButton1Down:Connect(function()
	while up.Parent and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
		task.wait(0.05)
		if flying and ghost and ghost.Parent then
			ghost:PivotTo(ghost:GetPivot() + Vector3.new(0, 1, 0))
		elseif rootPart and rootPart.Parent then
			rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 1, 0)
		end
	end
end)

down.MouseButton1Down:Connect(function()
	while down.Parent and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
		task.wait(0.05)
		if flying and ghost and ghost.Parent then
			ghost:PivotTo(ghost:GetPivot() + Vector3.new(0, -1, 0))
		elseif rootPart and rootPart.Parent then
			rootPart.CFrame = rootPart.CFrame * CFrame.new(0, -1, 0)
		end
	end
end)

plus.MouseButton1Down:Connect(function()
	speed = speed + 5
	speedLabel.Text = tostring(speed)
end)

mine.MouseButton1Down:Connect(function()
	if speed <= 5 then
		speedLabel.Text = "min 5"
		task.wait(1)
		speedLabel.Text = tostring(speed)
	else
		speed = speed - 5
		speedLabel.Text = tostring(speed)
	end
end)

closebutton.MouseButton1Click:Connect(function()
	if flying then pcall(stopFly) end
	main:Destroy()
end)

mini.MouseButton1Click:Connect(function()
	up.Visible = false
	down.Visible = false
	onof.Visible = false
	plus.Visible = false
	speedLabel.Visible = false
	mine.Visible = false
	mini.Visible = false
	mini2.Visible = true
	Frame.BackgroundTransparency = 1
	closebutton.Position = UDim2.new(0, 0, -1, 57)
end)

mini2.MouseButton1Click:Connect(function()
	up.Visible = true
	down.Visible = true
	onof.Visible = true
	plus.Visible = true
	speedLabel.Visible = true
	mine.Visible = true
	mini.Visible = true
	mini2.Visible = false
	Frame.BackgroundTransparency = 0
	closebutton.Position = UDim2.new(0, 0, -1, 27)
end)

player.CharacterAdded:Connect(function(newChar)
	if flying then pcall(stopFly) end
	task.wait(0.5)
	refreshChar()
	updateFlyButton()
end)
